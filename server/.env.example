NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=studykarle
DB_USER=postgres
DB_PASSWORD=postgres

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_NAME=studykarle_token

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token
GOOGLE_REDIRECT_URI=http://localhost:5000/oauth2callback
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id

# Drive sync scheduler (interval 0 disables the periodic run)
DRIVE_SYNC_INTERVAL_MS=0
DRIVE_SYNC_ON_START=true

RESEND_API_KEY=re_dummy_change_me
EMAIL_FROM=StudyKarle <onboarding@resend.dev>

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20
